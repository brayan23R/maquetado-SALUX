# ---- App móvil (se pasan con --dart-define) ----
APP_MODE=mock            # mock | supabase
SUPABASE_URL=http://10.0.2.2:54321   # 10.0.2.2 = tu PC visto desde el emulador Android
SUPABASE_ANON_KEY=

# ---- Servidor / Edge Functions / Admin (NUNCA en la app) ----
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=simulated   # simulated | culqi | niubiz | izipay
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- OAuth (opcional hasta tener claves) ----
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=
